{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'APP scan PDF: web app tĩnh trong site/ (bản Flutter build trên GitHub Actions)'",
  "buildCommand": "sh scripts/vercel_build.sh",
  "outputDirectory": "site",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [
      { "key": "Permissions-Policy", "value": "camera=(self), accelerometer=(self), gyroscope=(self)" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
